    LookupSound(tenv, x, env);
  }
}

function opTy(op: Op, a: Ty, b: Ty): TyResult
{
  if (a.TInt? && b.TInt?) then
    if (op.Lt? || op.Eq?) then
      Typed(Ty.TBool)
    else
      Typed(Ty.TInt)
  else
    if ((a.TBool? && b.TBool?) && op.Eq?) then
      Typed(Ty.TBool)
    else
      IllTyped(Fault.TypeError)
}

function typeOf(e: Expr, tenv: seq<TBinding>): TyResult
  decreases e
{
  match e {
    case Num(i_e_n) =>
      Typed(Ty.TInt)
    case Bool(i_e_b) =>
      Typed(Ty.TBool)
    case Var(i_e_x) =>
      lookupTy(tenv, i_e_x)
    case Let(i_e_x, i_e_rhs, i_e_body) =>
      var t1 := typeOf(i_e_rhs, tenv);
      match t1 {
        case IllTyped(i_t1_why) =>
          t1
        case Typed(i_t1_t) =>
          typeOf(i_e_body, ([TBinding(i_e_x, i_t1_t)] + tenv))
      }
    case Bin(i_e_op, i_e_l, i_e_r) =>
      var tl := typeOf(i_e_l, tenv);
      match tl {
        case IllTyped(i_tl_why) =>
          tl
        case Typed(i_tl_t) =>
          var tr := typeOf(i_e_r, tenv);
          match tr {
            case IllTyped(i_tr_why) =>
              tr
            case Typed(i_tr_t) =>
              opTy(i_e_op, i_tl_t, i_tr_t)
          }
      }
    case If(i_e_cond, i_e_thn, i_e_els) =>
      var tc := typeOf(i_e_cond, tenv);
      match tc {
        case IllTyped(i_tc_why) =>
          tc
        case Typed(i_tc_t) =>
          if (!i_tc_t.TBool?) then
            IllTyped(Fault.TypeError)
          else
            var tt := typeOf(i_e_thn, tenv);
            match tt {
              case IllTyped(i_tt_why) =>
                tt
              case Typed(i_tt_t) =>
                var te := typeOf(i_e_els, tenv);
                match te {
                  case IllTyped(i_te_why) =>
                    te
                  case Typed(i_te_t) =>
                    if (i_tt_t != i_te_t) then
                      IllTyped(Fault.TypeError)
                    else
                      tt
                }
            }
      }
  }
}

