    TypeSound(e, tenv, env);
  }
}

function noDiv(e: Expr): bool
  decreases e
{
  match e {
    case Num(i_e_n) =>
      true
    case Bool(i_e_b) =>
      true
    case Var(i_e_x) =>
      true
    case Let(i_e_x, i_e_rhs, i_e_body) =>
      (noDiv(i_e_rhs) && noDiv(i_e_body))
    case Bin(i_e_op, i_e_l, i_e_r) =>
      (((!i_e_op.Div?) && noDiv(i_e_l)) && noDiv(i_e_r))
    case If(i_e_cond, i_e_thn, i_e_els) =>
      ((noDiv(i_e_cond) && noDiv(i_e_thn)) && noDiv(i_e_els))
  }
}

function valueToExpr(v: Value): Expr
{
  match v {
    case VNum(i_v_n) =>
      Num(i_v_n)
    case VBool(i_v_b) =>
      Bool(i_v_b)
  }
}

function simplifyBin(op: Op, l: Expr, r: Expr): Expr
{
  if (l.Num? && r.Num?) then
    var folded := applyOp(op, VNum(l.n), VNum(r.n));
    match folded {
      case Ok(i_folded_v) =>
        valueToExpr(i_folded_v)
      case Err(i_folded_why) =>
        Bin(op, l, r)
    }
  else
    if ((l.Bool? && r.Bool?) && op.Eq?) then
      Bool((l.b == r.b))
    else
      if ((op.Add? && r.Num?) && (r.n == 0)) then
        l
      else
        if ((op.Add? && l.Num?) && (l.n == 0)) then
          r
        else
          if ((op.Sub? && r.Num?) && (r.n == 0)) then
            l
          else
            if ((op.Mul? && r.Num?) && (r.n == 1)) then
              l
            else
              if ((op.Mul? && l.Num?) && (l.n == 1)) then
                r
              else
                if ((op.Div? && r.Num?) && (r.n == 1)) then
                  l
                else
                  if (((op.Mul? && r.Num?) && (r.n == 0)) && noDiv(l)) then
                    Num(0)
                  else
                    if (((op.Mul? && l.Num?) && (l.n == 0)) && noDiv(r)) then
                      Num(0)
                    else
                      Bin(op, l, r)
}

lemma simplifyBin_ensures(op: Op, l: Expr, r: Expr)
  ensures (size(simplifyBin(op, l, r)) <= ((1 + size(l)) + size(r)))
  ensures forall tenv: TEnv :: (typeOf(Bin(op, l, r), tenv).Typed? ==> (typeOf(simplifyBin(op, l, r), tenv) == typeOf(Bin(op, l, r), tenv)))
