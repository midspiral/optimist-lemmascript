function halt(stack: seq<Value>, env: seq<Binding>): Outcome
{
  Halt(stack, env)
}

function crash(why: Fault): Outcome
{
  Crash(why)
}

function pushed(v: Value, stack: seq<Value>): seq<Value>
{
  ([v] + stack)
}

function run(code: seq<Instr>, stack: seq<Value>, env: seq<Binding>): Outcome
  decreases code
{
  if (|code| == 0) then
    halt(stack, env)
  else
    var ins := code[0];
    var rest := code[1..];
    match ins {
      case Push(i_ins_v) =>
        run(rest, ([i_ins_v] + stack), env)
      case Prim(i_ins_op) =>
        if (|stack| < 2) then
          crash(Fault.Underflow)
        else
          var b := stack[0];
          var a := stack[1];
          var res := applyOp(i_ins_op, a, b);
          match res {
            case Err(i_res_why) =>
              crash(i_res_why)
            case Ok(i_res_v) =>
              run(rest, ([i_res_v] + stack[2..]), env)
          }
      case Load(i_ins_x) =>
        var res := lookup(env, i_ins_x);
        match res {
          case Err(i_res_why) =>
            crash(i_res_why)
          case Ok(i_res_v) =>
            run(rest, ([i_res_v] + stack), env)
        }
      case Bind(i_ins_x) =>
        if (|stack| < 1) then
          crash(Fault.Underflow)
        else
          run(rest, stack[1..], ([Binding(i_ins_x, stack[0])] + env))
      case Unbind =>
        if (|env| < 1) then
          crash(Fault.Underflow)
        else
          run(rest, stack, env[1..])
      case Branch(i_ins_thn, i_ins_els) =>
        if (|stack| < 1) then
          crash(Fault.Underflow)
        else
          var c := stack[0];
          match c {
            case VBool(i_c_b) =>
              var inner := run((if i_c_b then i_ins_thn else i_ins_els), stack[1..], env);
              match inner {
                case Crash(i_inner_why) =>
                  inner
                case Halt(i_inner_stack, i_inner_env) =>
                  run(rest, i_inner_stack, i_inner_env)
              }
            case VNum(i_c_n) =>
              crash(Fault.TypeError)
          }
    }
}

function compile(e: Expr): seq<Instr>
  decreases e
{
  match e {
    case Num(i_e_n) =>
      [Push(VNum(i_e_n))]
    case Bool(i_e_b) =>
      [Push(VBool(i_e_b))]
    case Var(i_e_x) =>
      [Load(i_e_x)]
    case Let(i_e_x, i_e_rhs, i_e_body) =>
      (((compile(i_e_rhs) + [Bind(i_e_x)]) + compile(i_e_body)) + [Instr.Unbind])
    case Bin(i_e_op, i_e_l, i_e_r) =>
      ((compile(i_e_l) + compile(i_e_r)) + [Prim(i_e_op)])
    case If(i_e_cond, i_e_thn, i_e_els) =>
      (compile(i_e_cond) + [Branch(compile(i_e_thn), compile(i_e_els))])
  }
}

lemma compile_ensures(e: Expr)
  ensures forall env: Env, stack: Stack :: (evaluate(e, env).Ok? ==> (run(compile(e), stack, env) == halt(pushed(evaluate(e, env).v, stack), env)))
  ensures forall env: Env, stack: Stack :: (evaluate(e, env).Err? ==> (run(compile(e), stack, env) == crash(evaluate(e, env).why)))
{
  // T3 — instantiate CompileCorrect (induction on e, with RunAppend for code concatenation).
  forall env: Env, stack: Stack
    ensures evaluate(e, env).Ok? ==> run(compile(e), stack, env) == halt(pushed(evaluate(e, env).v, stack), env)
    ensures evaluate(e, env).Err? ==> run(compile(e), stack, env) == crash(evaluate(e, env).why)
  {
    CompileCorrect(e, stack, env);
  }
}

function runPipeline(e: Expr): Result
{
  var t := typeOf(e, []);
  match t {
    case IllTyped(i_t_why) =>
      Err(i_t_why)
    case Typed(i_t_t) =>
      var out := run(compile(optimize(e)), [], []);
      match out {
        case Crash(i_out_why) =>
          Err(i_out_why)
        case Halt(i_out_stack, i_out_env) =>
          if (|i_out_stack| != 1) then
            Err(Fault.Underflow)
          else
            Ok(i_out_stack[0])
      }
  }
}

lemma runPipeline_ensures(e: Expr)
  ensures (typeOf(e, []).Typed? ==> (runPipeline(e) == evaluate(e, [])))
{
  // T4 — compose T2 (at the empty environments) with T3 on the optimized program.
  if typeOf(e, []).Typed? {
    OptimizeSem(e, [], []);
    CompileCorrect(optimize(e), [], []);
  }
}


