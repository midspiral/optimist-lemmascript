// ───────────────────────── T1: type soundness ─────────────────────────

// A primitive applied to well-typed operands either returns a value of
// the predicted type or divides by zero. It never raises TypeError.
lemma ApplyOpTyped(op: Op, a: Value, b: Value, ta: Ty, tb: Ty)
  requires hasTy(a, ta) && hasTy(b, tb)
  requires opTy(op, ta, tb).Typed?
  ensures applyOp(op, a, b).Ok? ==> hasTy(applyOp(op, a, b).v, opTy(op, ta, tb).t)
  ensures applyOp(op, a, b).Err? ==> applyOp(op, a, b).why.DivByZero?
{
}

// If the typing environment knows x at type t, the matching run-time
// environment holds a value of type t for x. Induction on the environment.
lemma LookupSound(tenv: TEnv, x: string, env: Env)
  requires envMatches(env, tenv)
  requires lookupTy(tenv, x).Typed?
  ensures lookup(env, x).Ok? && hasTy(lookup(env, x).v, lookupTy(tenv, x).t)
  decreases tenv
{
  if |tenv| == 0 {
  } else if tenv[0].x == x {
  } else {
    LookupSound(tenv[1..], x, env[1..]);
  }
}

// Extending matching environments with a matching binding keeps them matching.
lemma EnvMatchesExtend(env: Env, tenv: TEnv, x: string, v: Value, t: Ty)
  requires envMatches(env, tenv)
  requires hasTy(v, t)
  ensures envMatches([Binding(x, v)] + env, [TBinding(x, t)] + tenv)
{
  var env2 := [Binding(x, v)] + env;
  var tenv2 := [TBinding(x, t)] + tenv;
  assert env2[1..] == env;
  assert tenv2[1..] == tenv;
}

// T1 with the environment made explicit. Structural induction on e.
// The Let case is the interesting one: the body is checked in an
// extended typing environment, so we run it in the correspondingly
// extended run-time environment, which EnvMatchesExtend says still matches.
lemma TypeSound(e: Expr, tenv: TEnv, env: Env)
  requires envMatches(env, tenv)
  requires typeOf(e, tenv).Typed?
  ensures evaluate(e, env).Ok? ==> hasTy(evaluate(e, env).v, typeOf(e, tenv).t)
  ensures evaluate(e, env).Err? ==> evaluate(e, env).why.DivByZero?
  decreases e
{
  match e {
    case Num(_) =>
    case Bool(_) =>
    case Var(x) =>
      LookupSound(tenv, x, env);
    case Let(x, rhs, body) =>
      TypeSound(rhs, tenv, env);
      var t1 := typeOf(rhs, tenv);
      var r1 := evaluate(rhs, env);
      if r1.Ok? {
        EnvMatchesExtend(env, tenv, x, r1.v, t1.t);
        TypeSound(body, [TBinding(x, t1.t)] + tenv, [Binding(x, r1.v)] + env);
      }
    case Bin(op, l, r) =>
      TypeSound(l, tenv, env);
      var lv := evaluate(l, env);
      if lv.Ok? {
        TypeSound(r, tenv, env);
        var rv := evaluate(r, env);
        if rv.Ok? {
          ApplyOpTyped(op, lv.v, rv.v, typeOf(l, tenv).t, typeOf(r, tenv).t);
        }
      }
    case If(c, t, el) =>
      TypeSound(c, tenv, env);
      var cv := evaluate(c, env);
      if cv.Ok? {
        TypeSound(t, tenv, env);
        TypeSound(el, tenv, env);
      }
  }
}

// ───────────── Totality: well-typed + division-free ⇒ a value ─────────────
//
// This is the side condition that licenses deleting a subexpression
// (x * 0 → 0). T1 leaves exactly one possible fault, DivByZero, and a
// division-free expression cannot raise it.
lemma NoDivTotal(e: Expr, tenv: TEnv, env: Env)
  requires envMatches(env, tenv)
  requires typeOf(e, tenv).Typed?
  requires noDiv(e)
  ensures evaluate(e, env).Ok?
  decreases e
{
  match e {
    case Num(_) =>
    case Bool(_) =>
    case Var(x) =>
      LookupSound(tenv, x, env);
    case Let(x, rhs, body) =>
      NoDivTotal(rhs, tenv, env);
      TypeSound(rhs, tenv, env);
      var t1 := typeOf(rhs, tenv);
      var r1 := evaluate(rhs, env);
      EnvMatchesExtend(env, tenv, x, r1.v, t1.t);
      NoDivTotal(body, [TBinding(x, t1.t)] + tenv, [Binding(x, r1.v)] + env);
    case Bin(op, l, r) =>
      NoDivTotal(l, tenv, env);
      NoDivTotal(r, tenv, env);
      TypeSound(l, tenv, env);
      TypeSound(r, tenv, env);
    case If(c, t, el) =>
      NoDivTotal(c, tenv, env);
      TypeSound(c, tenv, env);
      NoDivTotal(t, tenv, env);
      NoDivTotal(el, tenv, env);
  }
}

// ───────────────────────── T2: the optimizer ─────────────────────────

lemma FloorDivOne(n: int)
  ensures JSFloorDiv(n, 1) == n
{
}

lemma SimplifyBinSize(op: Op, l: Expr, r: Expr)
  ensures size(simplifyBin(op, l, r)) <= 1 + size(l) + size(r)
{
  size_ensures(l);
  size_ensures(r);
}

lemma SimplifyBinTy(op: Op, l: Expr, r: Expr, tenv: TEnv)
  requires typeOf(Bin(op, l, r), tenv).Typed?
  ensures typeOf(simplifyBin(op, l, r), tenv) == typeOf(Bin(op, l, r), tenv)
{
}

// Each rewrite rule, justified:
//   folding      — the literal IS the value the primitive computes;
//   identities   — T1 makes the surviving operand an integer (or a
//                  DivByZero, which both sides then raise);
//   annihilation — NoDivTotal makes the deleted operand a value, so
//                  deleting it loses no fault.
lemma SimplifyBinSem(op: Op, l: Expr, r: Expr, tenv: TEnv, env: Env)
  requires typeOf(Bin(op, l, r), tenv).Typed?
  requires envMatches(env, tenv)
  ensures evaluate(simplifyBin(op, l, r), env) == evaluate(Bin(op, l, r), env)
{
  TypeSound(l, tenv, env);
  TypeSound(r, tenv, env);
  if noDiv(l) {
    NoDivTotal(l, tenv, env);
  }
  if noDiv(r) {
    NoDivTotal(r, tenv, env);
  }
  var lv := evaluate(l, env);
  if lv.Ok? && lv.v.VNum? {
    FloorDivOne(lv.v.n);
  }
}

lemma SimplifyIfSize(c: Expr, t: Expr, e: Expr)
  ensures size(simplifyIf(c, t, e)) <= 1 + size(c) + size(t) + size(e)
{
  size_ensures(c);
  size_ensures(t);
  size_ensures(e);
}

lemma SimplifyIfTy(c: Expr, t: Expr, e: Expr, tenv: TEnv)
  requires typeOf(If(c, t, e), tenv).Typed?
  ensures typeOf(simplifyIf(c, t, e), tenv) == typeOf(If(c, t, e), tenv)
{
}

lemma SimplifyIfSem(c: Expr, t: Expr, e: Expr, tenv: TEnv, env: Env)
  requires typeOf(If(c, t, e), tenv).Typed?
  requires envMatches(env, tenv)
  ensures evaluate(simplifyIf(c, t, e), env) == evaluate(If(c, t, e), env)
{
}

lemma OptimizeSize(e: Expr)
  ensures size(optimize(e)) <= size(e)
  decreases e
{
  match e {
    case Num(_) =>
    case Bool(_) =>
    case Var(_) =>
    case Let(x, rhs, body) =>
      OptimizeSize(rhs);
      OptimizeSize(body);
    case Bin(op, l, r) =>
      OptimizeSize(l);
      OptimizeSize(r);
      SimplifyBinSize(op, optimize(l), optimize(r));
    case If(c, t, el) =>
      OptimizeSize(c);
      OptimizeSize(t);
      OptimizeSize(el);
      SimplifyIfSize(optimize(c), optimize(t), optimize(el));
  }
}

lemma OptimizeTy(e: Expr, tenv: TEnv)
  requires typeOf(e, tenv).Typed?
  ensures typeOf(optimize(e), tenv) == typeOf(e, tenv)
  decreases e
{
  match e {
    case Num(_) =>
    case Bool(_) =>
    case Var(_) =>
    case Let(x, rhs, body) =>
      OptimizeTy(rhs, tenv);
      var t1 := typeOf(rhs, tenv);
      OptimizeTy(body, [TBinding(x, t1.t)] + tenv);
    case Bin(op, l, r) =>
      OptimizeTy(l, tenv);
      OptimizeTy(r, tenv);
      assert typeOf(Bin(op, optimize(l), optimize(r)), tenv) == typeOf(Bin(op, l, r), tenv);
      SimplifyBinTy(op, optimize(l), optimize(r), tenv);
    case If(c, t, el) =>
      OptimizeTy(c, tenv);
      OptimizeTy(t, tenv);
      OptimizeTy(el, tenv);
      assert typeOf(If(optimize(c), optimize(t), optimize(el)), tenv) == typeOf(If(c, t, el), tenv);
      SimplifyIfTy(optimize(c), optimize(t), optimize(el), tenv);
  }
}

// T2 with the environments made explicit. Structural induction on e;
// the children are optimized first (bottom-up), so the inductive
// hypothesis rewrites them in place and the local rule lemma finishes.
lemma OptimizeSem(e: Expr, tenv: TEnv, env: Env)
  requires typeOf(e, tenv).Typed?
  requires envMatches(env, tenv)
  ensures evaluate(optimize(e), env) == evaluate(e, env)
  decreases e
{
  match e {
    case Num(_) =>
    case Bool(_) =>
    case Var(_) =>
    case Let(x, rhs, body) =>
      OptimizeSem(rhs, tenv, env);
      TypeSound(rhs, tenv, env);
      var t1 := typeOf(rhs, tenv);
      var r1 := evaluate(rhs, env);
      if r1.Ok? {
        EnvMatchesExtend(env, tenv, x, r1.v, t1.t);
        OptimizeSem(body, [TBinding(x, t1.t)] + tenv, [Binding(x, r1.v)] + env);
      }
    case Bin(op, l, r) =>
      OptimizeSem(l, tenv, env);
      OptimizeSem(r, tenv, env);
      OptimizeTy(l, tenv);
      OptimizeTy(r, tenv);
      var ol := optimize(l);
      var orr := optimize(r);
      assert typeOf(Bin(op, ol, orr), tenv) == typeOf(Bin(op, l, r), tenv);
      assert evaluate(Bin(op, ol, orr), env) == evaluate(Bin(op, l, r), env);
      SimplifyBinSem(op, ol, orr, tenv, env);
    case If(c, t, el) =>
      OptimizeSem(c, tenv, env);
      OptimizeSem(t, tenv, env);
      OptimizeSem(el, tenv, env);
      OptimizeTy(c, tenv);
      OptimizeTy(t, tenv);
      OptimizeTy(el, tenv);
      var oc := optimize(c);
      var ot := optimize(t);
      var oe := optimize(el);
      assert typeOf(If(oc, ot, oe), tenv) == typeOf(If(c, t, el), tenv);
      assert evaluate(If(oc, ot, oe), env) == evaluate(If(c, t, el), env);
      SimplifyIfSem(oc, ot, oe, tenv, env);
  }
}

// The naive optimizer at least never grows a program.
lemma NaiveBinSize(op: Op, l: Expr, r: Expr)
  ensures size(naiveBin(op, l, r)) <= 1 + size(l) + size(r)
{
  size_ensures(l);
  size_ensures(r);
}

lemma OptimizeNaiveSize(e: Expr)
  ensures size(optimizeNaive(e)) <= size(e)
  decreases e
{
  match e {
    case Num(_) =>
    case Bool(_) =>
    case Var(_) =>
    case Let(x, rhs, body) =>
      OptimizeNaiveSize(rhs);
      OptimizeNaiveSize(body);
    case Bin(op, l, r) =>
      OptimizeNaiveSize(l);
      OptimizeNaiveSize(r);
      NaiveBinSize(op, optimizeNaive(l), optimizeNaive(r));
    case If(c, t, el) =>
      OptimizeNaiveSize(c);
      OptimizeNaiveSize(t);
      OptimizeNaiveSize(el);
      SimplifyIfSize(optimizeNaive(c), optimizeNaive(t), optimizeNaive(el));
  }
}

// ─────────────── The counterexamples: why the rules need guards ───────────────

// (1 / 0) * 0 is well-typed and means "crash". The naive optimizer turns
// it into 0. The verified optimizer leaves it alone, as T2 requires.
lemma NaiveMulZero()
  ensures var e := Bin(Mul, Bin(Div, Num(1), Num(0)), Num(0));
    typeOf(e, []) == Typed(TInt)
    && evaluate(e, []) == Err(DivByZero)
    && evaluate(optimizeNaive(e), []) == Ok(VNum(0))
    && optimize(e) == e
{
  var inner := Bin(Div, Num(1), Num(0));
  var e := Bin(Mul, inner, Num(0));
  assert evaluate(inner, []) == Err(DivByZero);
  assert evaluate(e, []) == Err(DivByZero);
  assert optimizeNaive(inner) == inner;
  assert optimizeNaive(e) == Num(0);
  assert optimize(inner) == inner;
  assert !noDiv(inner);
  assert optimize(e) == e;
}

// The exact statement T2 makes about `optimize` is FALSE of `optimizeNaive`:
// there is a well-typed program whose meaning it changes.
lemma NaiveRefutesT2()
  ensures exists e: Expr :: typeOf(e, []).Typed? && evaluate(optimizeNaive(e), []) != evaluate(e, [])
{
  NaiveMulZero();
  var e := Bin(Mul, Bin(Div, Num(1), Num(0)), Num(0));
  assert typeOf(e, []).Typed? && evaluate(optimizeNaive(e), []) != evaluate(e, []);
}

// `true + 0` means TypeError, but x + 0 → x turns it into `true`. This is
// why T2 is stated for WELL-TYPED programs only: without the typing
// hypothesis even the identity rules are unsound — for the naive and the
// verified optimizer alike. The type checker rejects this program, so the
// pipeline (T4) never runs it.
lemma IdentityNeedsTypes()
  ensures var e := Bin(Add, Bool(true), Num(0));
    typeOf(e, []).IllTyped?
    && evaluate(e, []) == Err(TypeError)
    && evaluate(optimizeNaive(e), []) == Ok(VBool(true))
    && evaluate(optimize(e), []) == Ok(VBool(true))
{
  var e := Bin(Add, Bool(true), Num(0));
  assert evaluate(e, []) == Err(TypeError);
  assert optimizeNaive(e) == Bool(true);
  assert optimize(e) == Bool(true);
}

// ───────────────────── T3: the compiler and the machine ─────────────────────

// Running concatenated code is running the first block, then — if it
// halted — running the second from where the first left off. Induction
// on the first block; this is the glue for every compile case.
lemma RunAppend(c1: seq<Instr>, c2: seq<Instr>, stack: Stack, env: Env)
  ensures run(c1, stack, env).Crash? ==> run(c1 + c2, stack, env) == run(c1, stack, env)
  ensures run(c1, stack, env).Halt? ==> run(c1 + c2, stack, env) == run(c2, run(c1, stack, env).stack, run(c1, stack, env).env)
  decreases c1
{
  if |c1| == 0 {
    assert c1 + c2 == c2;
  } else {
    var ins := c1[0];
    var rest := c1[1..];
    assert (c1 + c2)[0] == ins;
    assert (c1 + c2)[1..] == rest + c2;
    match ins {
      case Push(v) =>
        RunAppend(rest, c2, [v] + stack, env);
      case Prim(op) =>
        if |stack| >= 2 {
          var res := applyOp(op, stack[1], stack[0]);
          if res.Ok? {
            RunAppend(rest, c2, [res.v] + stack[2..], env);
          }
        }
      case Load(x) =>
        var res := lookup(env, x);
        if res.Ok? {
          RunAppend(rest, c2, [res.v] + stack, env);
        }
      case Bind(x) =>
        if |stack| >= 1 {
          RunAppend(rest, c2, stack[1..], [Binding(x, stack[0])] + env);
        }
      case Unbind =>
        if |env| >= 1 {
          RunAppend(rest, c2, stack, env[1..]);
        }
      case Branch(thn, els) =>
        if |stack| >= 1 && stack[0].VBool? {
          var inner := run(if stack[0].b then thn else els, stack[1..], env);
          if inner.Halt? {
            RunAppend(rest, c2, inner.stack, inner.env);
          }
        }
    }
  }
}

// T3 with stack and environment made explicit. Structural induction on e.
// Every case: split the generated code into its blocks with RunAppend,
// use the inductive hypothesis on each sub-program, and step the single
// instruction that combines their results.
lemma CompileCorrect(e: Expr, stack: Stack, env: Env)
  ensures evaluate(e, env).Ok? ==> run(compile(e), stack, env) == Halt([evaluate(e, env).v] + stack, env)
  ensures evaluate(e, env).Err? ==> run(compile(e), stack, env) == Crash(evaluate(e, env).why)
  decreases e
{
  match e {
    case Num(n) =>
      assert run(compile(e), stack, env) == run([], [VNum(n)] + stack, env);
    case Bool(b) =>
      assert run(compile(e), stack, env) == run([], [VBool(b)] + stack, env);
    case Var(x) =>
      var res := lookup(env, x);
      if res.Ok? {
        assert run(compile(e), stack, env) == run([], [res.v] + stack, env);
      }
    case Let(x, rhs, body) =>
      var c1 := compile(rhs);
      var c2 := [Bind(x)];
      var c3 := compile(body);
      var c4 := [Instr.Unbind];
      assert compile(e) == c1 + (c2 + (c3 + c4));
      CompileCorrect(rhs, stack, env);
      RunAppend(c1, c2 + (c3 + c4), stack, env);
      var r1 := evaluate(rhs, env);
      if r1.Ok? {
        var stack1 := [r1.v] + stack;
        var env2 := [Binding(x, r1.v)] + env;
        assert run(c2, stack1, env) == run([], stack, env2);
        RunAppend(c2, c3 + c4, stack1, env);
        CompileCorrect(body, stack, env2);
        RunAppend(c3, c4, stack, env2);
        var r2 := evaluate(body, env2);
        if r2.Ok? {
          assert env2[1..] == env;
          assert run(c4, [r2.v] + stack, env2) == run([], [r2.v] + stack, env);
        }
      }
    case Bin(op, l, r) =>
      var cl := compile(l);
      var cr := compile(r);
      assert compile(e) == (cl + cr) + [Prim(op)];
      CompileCorrect(l, stack, env);
      RunAppend(cl, cr, stack, env);
      RunAppend(cl + cr, [Prim(op)], stack, env);
      var lv := evaluate(l, env);
      if lv.Ok? {
        CompileCorrect(r, [lv.v] + stack, env);
        var rv := evaluate(r, env);
        if rv.Ok? {
          var st := [rv.v] + ([lv.v] + stack);
          assert st[0] == rv.v && st[1] == lv.v && st[2..] == stack;
          var res := applyOp(op, lv.v, rv.v);
          if res.Ok? {
            assert run([Prim(op)], st, env) == run([], [res.v] + stack, env);
          }
        }
      }
    case If(c, t, el) =>
      var cc := compile(c);
      var br := [Branch(compile(t), compile(el))];
      assert compile(e) == cc + br;
      CompileCorrect(c, stack, env);
      RunAppend(cc, br, stack, env);
      var cv := evaluate(c, env);
      if cv.Ok? && cv.v.VBool? {
        var st := [cv.v] + stack;
        assert st[1..] == stack;
        CompileCorrect(t, stack, env);
        CompileCorrect(el, stack, env);
        var inner := run(if cv.v.b then compile(t) else compile(el), stack, env);
        if inner.Halt? {
          assert run(br, st, env) == run([], inner.stack, inner.env);
        }
      }
  }
}
