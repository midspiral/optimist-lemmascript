// Generated by lsc from core.ts

function JSFloorDiv(a: int, b: int): int
  requires b != 0
{
  if b > 0 then
    if a >= 0 then a / b
    else -((-a - 1) / b) - 1
  else
    if a <= 0 then (-a) / (-b)
    else -((a - 1) / (-b)) - 1
}

datatype Op = Add | Sub | Mul | Div | Lt | Eq

datatype Expr = Num(n: int) | Bool(b: bool) | Var(x: string) | Let(x: string, rhs: Expr, body: Expr) | Bin(op: Op, l: Expr, r: Expr) | If(cond: Expr, thn: Expr, els: Expr)

datatype Value = VNum(n: int) | VBool(b: bool)

datatype Fault = DivByZero | Unbound | TypeError | Underflow

datatype Result = Ok(v: Value) | Err(why: Fault)

datatype Binding = Binding(x: string, v: Value)

type Env = seq<Binding>

datatype Ty = TInt | TBool

datatype TBinding = TBinding(x: string, t: Ty)

type TEnv = seq<TBinding>

datatype TyResult = Typed(t: Ty) | IllTyped(why: Fault)

datatype Instr = Push(v: Value) | Prim(op: Op) | Load(x: string) | Bind(x: string) | Unbind | Branch(thn: seq<Instr>, els: seq<Instr>)

type Stack = seq<Value>

datatype Outcome = Halt(stack: seq<Value>, env: seq<Binding>) | Crash(why: Fault)

function size(e: Expr): int
  decreases e
{
  match e {
    case Num(i_e_n) =>
      1
    case Bool(i_e_b) =>
      1
    case Var(i_e_x) =>
      1
    case Let(i_e_x, i_e_rhs, i_e_body) =>
      ((1 + size(i_e_rhs)) + size(i_e_body))
    case Bin(i_e_op, i_e_l, i_e_r) =>
      ((1 + size(i_e_l)) + size(i_e_r))
    case If(i_e_cond, i_e_thn, i_e_els) =>
      (((1 + size(i_e_cond)) + size(i_e_thn)) + size(i_e_els))
  }
}

lemma size_ensures(e: Expr)
  ensures (size(e) >= 1)
{
}

function lookup(env: seq<Binding>, x: string): Result
  decreases env
{
  if (|env| == 0) then
    Err(Fault.Unbound)
  else
    if (env[0].x == x) then
      Ok(env[0].v)
    else
      lookup(env[1..], x)
}

function applyOp(op: Op, a: Value, b: Value): Result
{
  if (a.VNum? && b.VNum?) then
    if op.Add? then
      Ok(VNum((a.n + b.n)))
    else
      if op.Sub? then
        Ok(VNum((a.n - b.n)))
      else
        if op.Mul? then
          Ok(VNum((a.n * b.n)))
        else
          if op.Div? then
            if (b.n == 0) then
              Err(Fault.DivByZero)
            else
              Ok(VNum(JSFloorDiv(a.n, b.n)))
          else
            if op.Lt? then
              Ok(VBool((a.n < b.n)))
            else
              Ok(VBool((a.n == b.n)))
  else
    if ((a.VBool? && b.VBool?) && op.Eq?) then
      Ok(VBool((a.b == b.b)))
    else
      Err(Fault.TypeError)
}

function evaluate(e: Expr, env: seq<Binding>): Result
  decreases e
{
  match e {
    case Num(i_e_n) =>
      Ok(VNum(i_e_n))
    case Bool(i_e_b) =>
      Ok(VBool(i_e_b))
    case Var(i_e_x) =>
      lookup(env, i_e_x)
    case Let(i_e_x, i_e_rhs, i_e_body) =>
      var r1 := evaluate(i_e_rhs, env);
      match r1 {
        case Err(i_r1_why) =>
          r1
        case Ok(i_r1_v) =>
          evaluate(i_e_body, ([Binding(i_e_x, i_r1_v)] + env))
      }
    case Bin(i_e_op, i_e_l, i_e_r) =>
      var l := evaluate(i_e_l, env);
      match l {
        case Err(i_l_why) =>
          l
        case Ok(i_l_v) =>
          var r := evaluate(i_e_r, env);
          match r {
            case Err(i_r_why) =>
              r
            case Ok(i_r_v) =>
              applyOp(i_e_op, i_l_v, i_r_v)
          }
      }
    case If(i_e_cond, i_e_thn, i_e_els) =>
      var c := evaluate(i_e_cond, env);
      match c {
        case Err(i_c_why) =>
          c
        case Ok(i_c_v) =>
          if (!i_c_v.VBool?) then
            Err(Fault.TypeError)
          else
            if i_c_v.b then
              evaluate(i_e_thn, env)
            else
              evaluate(i_e_els, env)
      }
  }
}

function hasTy(v: Value, t: Ty): bool
{
  match v {
    case VNum(i_v_n) =>
      t.TInt?
    case VBool(i_v_b) =>
      t.TBool?
  }
}

function envMatches(env: seq<Binding>, tenv: seq<TBinding>): bool
  decreases env
{
  if (|env| == 0) then
    (|tenv| == 0)
  else
    if (|tenv| == 0) then
      false
    else
      (((env[0].x == tenv[0].x) && hasTy(env[0].v, tenv[0].t)) && envMatches(env[1..], tenv[1..]))
}

function lookupTy(tenv: seq<TBinding>, x: string): TyResult
  decreases tenv
{
  if (|tenv| == 0) then
    IllTyped(Fault.Unbound)
  else
    if (tenv[0].x == x) then
      Typed(tenv[0].t)
    else
      lookupTy(tenv[1..], x)
}

