function naiveBin(op: Op, l: Expr, r: Expr): Expr
{
  if (l.Num? && r.Num?) then
    var folded := applyOp(op, VNum(l.n), VNum(r.n));
    match folded {
      case Ok(i_folded_v) =>
        valueToExpr(i_folded_v)
      case Err(i_folded_why) =>
        Bin(op, l, r)
    }
  else
    if ((op.Add? && r.Num?) && (r.n == 0)) then
      l
    else
      if ((op.Add? && l.Num?) && (l.n == 0)) then
        r
      else
        if ((op.Sub? && r.Num?) && (r.n == 0)) then
          l
        else
          if ((op.Mul? && r.Num?) && (r.n == 1)) then
            l
          else
            if ((op.Mul? && l.Num?) && (l.n == 1)) then
              r
            else
              if ((op.Div? && r.Num?) && (r.n == 1)) then
                l
              else
                if ((op.Mul? && r.Num?) && (r.n == 0)) then
                  Num(0)
                else
                  if ((op.Mul? && l.Num?) && (l.n == 0)) then
                    Num(0)
                  else
                    Bin(op, l, r)
}

function optimizeNaive(e: Expr): Expr
  decreases e
{
  match e {
    case Num(i_e_n) =>
      e
    case Bool(i_e_b) =>
      e
    case Var(i_e_x) =>
      e
    case Let(i_e_x, i_e_rhs, i_e_body) =>
      Let(i_e_x, optimizeNaive(i_e_rhs), optimizeNaive(i_e_body))
    case Bin(i_e_op, i_e_l, i_e_r) =>
      naiveBin(i_e_op, optimizeNaive(i_e_l), optimizeNaive(i_e_r))
    case If(i_e_cond, i_e_thn, i_e_els) =>
      simplifyIf(optimizeNaive(i_e_cond), optimizeNaive(i_e_thn), optimizeNaive(i_e_els))
  }
}

