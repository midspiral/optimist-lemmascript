function opTy(op: Op, a: Ty, b: Ty): TyResult
{
  if (a.TInt? && b.TInt?) then
    if (op.Lt? || op.Eq?) then
      Typed(Ty.TBool)
    else
      Typed(Ty.TInt)
  else
    if ((a.TBool? && b.TBool?) && op.Eq?) then
      Typed(Ty.TBool)
    else
      IllTyped(Fault.TypeError)
}

function typeOf(e: Expr, tenv: seq<TBinding>): TyResult
  decreases e
{
