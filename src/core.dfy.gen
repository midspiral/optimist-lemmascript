function optimize(e: Expr): Expr
  decreases e
{
  match e {
    case Num(i_e_n) =>
      e
    case Bool(i_e_b) =>
      e
    case Var(i_e_x) =>
      e
    case Let(i_e_x, i_e_rhs, i_e_body) =>
      Let(i_e_x, optimize(i_e_rhs), optimize(i_e_body))
    case Bin(i_e_op, i_e_l, i_e_r) =>
      simplifyBin(i_e_op, optimize(i_e_l), optimize(i_e_r))
    case If(i_e_cond, i_e_thn, i_e_els) =>
      simplifyIf(optimize(i_e_cond), optimize(i_e_thn), optimize(i_e_els))
