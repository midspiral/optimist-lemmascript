        case Ok(i_c_v) =>
          if (!i_c_v.VBool?) then
            Err(Fault.TypeError)
          else
            if i_c_v.b then
              evaluate(i_e_thn, env)
            else
              evaluate(i_e_els, env)
      }
  }
}

