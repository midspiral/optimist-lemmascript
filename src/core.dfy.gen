  }
}

function simplifyBin(op: Op, l: Expr, r: Expr): Expr
{
  if (l.Num? && r.Num?) then
    var folded := applyOp(op, VNum(l.n), VNum(r.n));
    match folded {
      case Ok(i_folded_v) =>
        valueToExpr(i_folded_v)
      case Err(i_folded_why) =>
        Bin(op, l, r)
    }
  else
    if ((l.Bool? && r.Bool?) && op.Eq?) then
      Bool((l.b == r.b))
    else
      if ((op.Add? && r.Num?) && (r.n == 0)) then
        l
      else
        if ((op.Add? && l.Num?) && (l.n == 0)) then
          r
        else
          if ((op.Sub? && r.Num?) && (r.n == 0)) then
            l
          else
            if ((op.Mul? && r.Num?) && (r.n == 1)) then
              l
            else
              if ((op.Mul? && l.Num?) && (l.n == 1)) then
                r
              else
                if ((op.Div? && r.Num?) && (r.n == 1)) then
                  l
                else
                  if (((op.Mul? && r.Num?) && (r.n == 0)) && noDiv(l)) then
                    Num(0)
                  else
                    if (((op.Mul? && l.Num?) && (l.n == 0)) && noDiv(r)) then
                      Num(0)
                    else
                      Bin(op, l, r)
}

