    case If(i_e_cond, i_e_thn, i_e_els) =>
      var tc := typeOf(i_e_cond, tenv);
      match tc {
        case IllTyped(i_tc_why) =>
          tc
        case Typed(i_tc_t) =>
          if (!i_tc_t.TBool?) then
            IllTyped(Fault.TypeError)
          else
            var tt := typeOf(i_e_thn, tenv);
            match tt {
              case IllTyped(i_tt_why) =>
                tt
              case Typed(i_tt_t) =>
                var te := typeOf(i_e_els, tenv);
                match te {
                  case IllTyped(i_te_why) =>
                    te
                  case Typed(i_te_t) =>
                    if (i_tt_t != i_te_t) then
                      IllTyped(Fault.TypeError)
                    else
