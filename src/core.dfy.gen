        case Ok(i_r1_v) =>
          evaluate(i_e_body, ([Binding(i_e_x, i_r1_v)] + env))
      }
    case Bin(i_e_op, i_e_l, i_e_r) =>
      var l := evaluate(i_e_l, env);
      match l {
        case Err(i_l_why) =>
          l
        case Ok(i_l_v) =>
          var r := evaluate(i_e_r, env);
          match r {
            case Err(i_r_why) =>
              r
            case Ok(i_r_v) =>
              applyOp(i_e_op, i_l_v, i_r_v)
          }
      }
    case If(i_e_cond, i_e_thn, i_e_els) =>
      var c := evaluate(i_e_cond, env);
      match c {
        case Err(i_c_why) =>
