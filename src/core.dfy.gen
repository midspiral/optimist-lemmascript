function lookup(env: seq<Binding>, x: string): Result
  decreases env
{
  if (|env| == 0) then
    Err(Fault.Unbound)
  else
    if (env[0].x == x) then
      Ok(env[0].v)
    else
      lookup(env[1..], x)
}

function applyOp(op: Op, a: Value, b: Value): Result
{
  if (a.VNum? && b.VNum?) then
    if op.Add? then
      Ok(VNum((a.n + b.n)))
    else
      if op.Sub? then
        Ok(VNum((a.n - b.n)))
      else
        if op.Mul? then
          Ok(VNum((a.n * b.n)))
        else
          if op.Div? then
            if (b.n == 0) then
              Err(Fault.DivByZero)
            else
              Ok(VNum(JSFloorDiv(a.n, b.n)))
          else
            if op.Lt? then
              Ok(VBool((a.n < b.n)))
            else
              Ok(VBool((a.n == b.n)))
  else
    if ((a.VBool? && b.VBool?) && op.Eq?) then
      Ok(VBool((a.b == b.b)))
    else
      Err(Fault.TypeError)
}

function evaluate(e: Expr, env: seq<Binding>): Result
  decreases e
{
  match e {
    case Num(i_e_n) =>
      Ok(VNum(i_e_n))
    case Bool(i_e_b) =>
      Ok(VBool(i_e_b))
    case Var(i_e_x) =>
      lookup(env, i_e_x)
    case Let(i_e_x, i_e_rhs, i_e_body) =>
      var r1 := evaluate(i_e_rhs, env);
      match r1 {
        case Err(i_r1_why) =>
